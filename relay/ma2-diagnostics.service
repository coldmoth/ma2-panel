[Unit]
Description=MA2 diagnostics HTTPS receiver backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ma2-diagnostics
Group=ma2-diagnostics
WorkingDirectory=/opt/ma2-diagnostics
ExecStart=/opt/ma2-diagnostics/.venv/bin/uvicorn relay.app:configured_app --factory --host 127.0.0.1 --port 8767 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
StateDirectory=ma2-diagnostics
StateDirectoryMode=0700
Environment=MA2_DIAGNOSTICS_STATE=/var/lib/ma2-diagnostics
Environment=MA2_DIAGNOSTICS_CREDENTIALS=/etc/ma2-diagnostics/github.json
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ma2-diagnostics
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
